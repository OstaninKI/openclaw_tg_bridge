{
  "id": "telegram-user-bridge",
  "name": "Unofficial Telegram User Bridge",
  "version": "0.1.0",
  "description": "Agent tools and DM channel for one live Telegram user account with isolated OpenClaw contexts and backend-enforced policies.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8765",
        "description": "Bridge HTTP API base URL"
      },
      "apiToken": {
        "type": "string",
        "description": "Optional Bearer token (set TELEGRAM_BRIDGE_API_TOKEN on backend to require)"
      },
      "timeoutMs": {
        "type": "number",
        "default": 25000,
        "description": "HTTP request timeout in milliseconds"
      },
      "policyProfile": {
        "type": "string",
        "description": "Backend policy profile for the legacy single-context mode"
      },
      "replyDelaySec": {
        "type": "number",
        "default": 2,
        "description": "Reply delay override enforced by the backend in legacy single-context mode"
      },
      "replyDelayMaxSec": {
        "type": "number",
        "description": "Optional max delay override enforced by the backend in legacy single-context mode"
      },
      "allowFrom": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Readable chat ids/usernames enforced by the backend in legacy single-context mode"
      },
      "denyFrom": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Denied read chat ids/usernames enforced by the backend in legacy single-context mode"
      },
      "writeTo": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Writable chat ids/usernames enforced by the backend in legacy single-context mode; empty means write denied"
      },
      "denyWriteTo": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Denied write chat ids/usernames enforced by the backend in legacy single-context mode"
      },
      "profiles": {
        "type": "array",
        "description": "Optional isolated OpenClaw contexts that register separate tool sets bound to backend policy profiles",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "description": "Stable tool/profile id, for example owner_dm, trusted_dm, sources_ro" },
            "label": { "type": "string", "description": "Human-readable label used in tool descriptions" },
            "enabled": { "type": "boolean", "default": true },
            "mode": {
              "type": "string",
              "enum": ["interactive", "sources_ro"],
              "default": "interactive",
              "description": "interactive = dialogs/messages/send tools, sources_ro = auto-discovered read-only source tools"
            },
            "privilegedTools": {
              "type": "boolean",
              "default": false,
              "description": "Expose backend-host file tools and self-account/contact mutation tools for this profile"
            },
            "backendFileTools": {
              "type": "boolean",
              "default": false,
              "description": "Expose only backend-host file/media tools for this profile. This enables send_file, send_voice, send_sticker, and download_media without contact/account mutation tools."
            },
            "policyProfile": { "type": "string", "description": "Backend policy profile to use for this context" },
            "replyDelaySec": { "type": "number" },
            "replyDelayMaxSec": { "type": "number" },
            "allowFrom": { "type": "array", "items": { "type": "string" } },
            "denyFrom": { "type": "array", "items": { "type": "string" } },
            "writeTo": { "type": "array", "items": { "type": "string" } },
            "denyWriteTo": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "uiHints": {
    "baseUrl": { "label": "Bridge URL", "placeholder": "http://127.0.0.1:8765" },
    "apiToken": { "label": "API Token", "sensitive": true },
    "timeoutMs": { "label": "Timeout (ms)" },
    "policyProfile": { "label": "Policy profile" },
    "replyDelaySec": { "label": "Reply delay (sec)" },
    "replyDelayMaxSec": { "label": "Reply delay max (sec)" }
  },
  "contracts": {
    "tools": [
      "telegram_*_send_message",
